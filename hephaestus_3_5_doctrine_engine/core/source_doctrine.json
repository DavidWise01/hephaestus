{
  "name": "defense-first-command-law",
  "version": "1.0.0",
  "principles": [
    "preserve evidence",
    "contain critical threats",
    "avoid unnecessary disruption",
    "recover trusted service",
    "audit every command"
  ],
  "rules": [
    {
      "id": "R001",
      "level": 1,
      "domain": "evidence",
      "law": "snapshot evidence before destructive response",
      "priority": 100
    },
    {
      "id": "R002",
      "level": 1,
      "domain": "critical_threat",
      "law": "critical threat permits quarantine",
      "priority": 95
    },
    {
      "id": "R003",
      "level": 2,
      "domain": "service_continuity",
      "law": "prefer rollback before kill when recovery path exists",
      "priority": 80
    },
    {
      "id": "R004",
      "level": 2,
      "domain": "operator_control",
      "law": "manual override requires audit receipt",
      "priority": 90
    },
    {
      "id": "R005",
      "level": 3,
      "domain": "deescalation",
      "law": "deescalate when threat score is below 50",
      "priority": 60
    }
  ],
  "constraints": [
    {
      "id": "C001",
      "text": "no command may bypass audit"
    },
    {
      "id": "C002",
      "text": "no rollback without known trusted baseline"
    },
    {
      "id": "C003",
      "text": "no kill before containment simulation unless criticality exceeds 95"
    }
  ]
}